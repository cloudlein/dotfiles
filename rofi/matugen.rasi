/* =========================================
 * Matugen → Rofi Material You Colors
 * ========================================= */

* {
    bg: #14140c;
    bg-alt: #212018;
    bg-high: #2b2a22;

    fg: #e6e2d5;
    fg-muted: #cac7b6;

    primary: #ceca75;
    on-primary: #333200;

    primary-container: #4b4900;
    on-primary-container: #eae68e;

    secondary: #cbc8a4;
    secondary-container: #49482c;

    outline: #949181;
    outline-variant: #49473a;

    error: #ffb4ab;
    on-error: #690005;
}
